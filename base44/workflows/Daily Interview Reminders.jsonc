{
  "name": "Daily Interview Reminders",
  "description": "Automatically sends interview reminders to candidates and recruiters 24 hours before scheduled interviews\"",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 24,
      "interval_unit": "hours",
      "interval_anchor": "2026-02-05T21:14:17.221000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_interview_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendInterviewReminders",
            "args": {
              "hoursBeforeInterview": 24,
              "includeRecruiter": true
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendInterviewReminders"
  }
}