{
  "name": "Interview Completion Feedback",
  "description": "When an interview is marked completed, auto-create an interview feedback record and email the candidate a feedback request.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Interview"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "interview_completion_feedback",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageInterviewFeedback",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "manageInterviewFeedback"
  }
}