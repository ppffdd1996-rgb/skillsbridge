{
  "name": "Offer Accepted Onboarding",
  "description": "When an offer letter is marked accepted (signed), auto-generate a personalized onboarding checklist and email it to the candidate.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"signature_status\") != null) and (.trigger.data.signature_status == \"signed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "OfferLetter"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "offer_accepted_onboarding",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "startCandidateOnboarding",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "startCandidateOnboarding"
  }
}